; RB2301 CA2 -- where the real maze sits in the Optitrack frame.
;
; SET BY THE TAs / INSTRUCTORS (3 numbers). Students: do not edit this file.
; The maze itself (ca2_irl_map.npy) and its start/goal points
; (ca2_irl_layout.json) are fixed and measured in "maze-local" metres:
;   (0, 0) = the OUTER corner of the maze's bottom-left cell, i.e. array cell [0, 0]
;   +x     = along array axis 0 (the maze's long axis as drawn in the blueprint, left -> right)
;   +y     = along array axis 1 (bottom -> top in the blueprint)
; Optitrack reports poses in its own frame. Tell the code how they relate:
;
;   origin_x, origin_y : the Optitrack (x, y), in metres, of the maze's (0, 0) corner
;   rotation_deg       : the angle, in degrees, of the maze's +x axis as seen in the
;                        Optitrack frame; counter-clockwise is positive
;                        (0 if the maze's +x already points along Optitrack's +x)
;
; Don't compute these by hand: put the robot at two or more known maze points,
; read the Optitrack pose at each, and let tools/irl_calibrate.py solve for them.
; (See the README, "For TAs / instructors: calibrating the maze mapping".)

[frame]
origin_x = 2.746
origin_y = -2.926
rotation_deg = 87.86
; heading_offset_deg: how far the Motive rigid body's heading is from the robot's real front (measured by driving the robot
; forward a few cm: reported heading minus the direction it really moved). Default for robots not listed below.
heading_offset_deg = 0.0

[heading_offsets]
; Per-robot override of heading_offset_deg, as  <robot number> = <degrees>.  Rigid bodies are made per robot, so measure each one
; (tools/robot_test/multi_robot_test.py heading N --apply).  Measured 2026-10-05, each verified to within 1 degree.
7 = -177.7
12 = -175.4

[robot]
; Fallback robot number (used only if --robot is not given and ROS_DOMAIN_ID is not the robot number).
number = 7
